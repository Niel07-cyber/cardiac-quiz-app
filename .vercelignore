# Exclude ALL video files to prevent OOM and rate limits
public/mp4/
*.mp4

# Exclude backend directory completely
backend/

# Exclude all Python files except API directory
*.py
!api/

# Exclude data files
*.pkl
*.csv
*.txt
!requirements.txt

# Exclude documentation
*.md
*.pdf

# Exclude screenshots and images except essentials
*.png
*.jpg
!public/favicon.ico
!public/robots.txt

# Exclude development files
node_modules/
.git/
*.log
.env*

# Exclude other large files
bun.lockb
start.bat
start.ps1
setup.ps1
VolumeTracings.csv
extract_*.py
fix_*.py
update_*.py
generate_*.py
